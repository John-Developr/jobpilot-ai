# Copy to .env.local and fill in. Never commit real values.
# Full reference: docs/deployment/environment-variables.md

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API. The publishable key is browser-safe (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Portfolio sync (optional) -----------------------------------------------
# Read-only login to the portfolio database (role jobpilot_reader). Server-only. Use the Supabase
# pooler connection string, e.g. postgresql://jobpilot_reader.<project-ref>:<password>@<pooler-host>:6543/postgres
# PORTFOLIO_DATABASE_URL=

# --- Not used yet: listed so the deployment plan is visible -----------------
# Server-only secret key for background workers (bypasses RLS). Never expose to the browser.
# SUPABASE_SECRET_KEY=
# --- AI (optional) ----------------------------------------------------------
# AI provider for scoring, Studio and Ask JobPilot (server only): gemini or openai.
# When unset, gemini is used if GEMINI_API_KEY is present, otherwise openai.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# Optional extra keys, used in order when earlier keys hit a limit or are rejected (GEMINI_API_KEY2, GEMINI_API_KEY_3, …).
# GEMINI_API_KEY2=
# OPENAI_API_KEY=
# Optional models for every prompt, in fallback order, comma-separated
# (default on Gemini: gemini-2.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite; on OpenAI: each prompt's default model).
# AI_MODEL=
# Trigger.dev project secret for background jobs (Phase 7).
# TRIGGER_SECRET_KEY=
# Sentry DSN for error reporting (Phase 8).
# SENTRY_DSN=
